# =====================================================================
# Project-specific
# =====================================================================
# Raw HousingQA download (~4 GB statutes corpus) - re-download from HF
data/raw/*
!data/raw/.gitkeep

# BM25 indexes - rebuildable via notebooks/03-build-corpus-index.ipynb
data/index/*
!data/index/.gitkeep

# NOTE: data/processed/*.jsonl IS committed so the whole team uses the same split.

# Model checkpoints (hundreds of MB) - store on Google Drive instead
models/*
!models/.gitkeep

# Training artifacts / logs
checkpoints/
runs/
logs/
outputs/
lightning_logs/
wandb/
mlruns/
*.log

